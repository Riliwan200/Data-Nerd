- What’s the average transaction amount?

select avg(money) as average_transaction_amount
left join index_2 on index_1.date = index_2.date
from index_1;



- Which coffee was sold the most times?

select coffee_name,  count (coffee_name) as coffee_sold
from index_1
left join index_2 on index_1.date = index_2.date
group by coffee_name
Order by count (coffee_name) desc
Limit 1;


- List all transactions where the amount is greater than 30.

select money 
from index_1
left join index_2 on index_1.date = index_2.date
where money > 30;



- Show all sales on a specific day (e.g., 2024-03-01).


select coffee_name, money
from index_1
left join index_2 on index_1.date = index_2.date
where date = '2024-03-01';


- Get the total money made from cash transactions.

select sum (money) as cash_transactions
from index_1
left join index_2 on index_1.date = index_2.date
where cash_type = 'cash';



- List all transactions made using a card (from index_1).

select coffee_name, money as card_transactions
from index_1
where cash_type = 'card';


- Find the earliest and latest transaction date.




🟡 Medium (Intermediate)


- Group sales by coffee_name and show their total revenue.

select distinct coffee_name, sum (money) as total_revenue
left join index_2 on index_1.date = index_2.date
from index_1
group by distinct coffee_name; 


- How much was spent by each card (ignore nulls)?

select cash_type, money as money_spent_on_each_card
from index_1
left join index_2 on index_1.date = index_2.date
where cash_type = 'card' and card IS NOT NULL;



- Which day had the highest number of transactions?

select distinct date, count (coffee_name) as number_of_transactions
from index_1
left join index_2 on index_1.date = index_2.date
group by date
order by count (coffee_name) desc
Limit 5;



- Find the top 3 most expensive individual transactions.


select distinct (index_1.coffee_name), max (index_1.money) as expensive_transactions
from index_1
left join index_2 on index_1.date = index_2.date
group by (index_1.coffee_name)
order by expensive_transactions desc
limit 3


- How many different cardholders bought a “Latte”?

select count(index_1.cash_type) as cardholders, index_1.coffee_name 
from index_1
left join index_2 on index_1.date = index_2.date 
where index_1.coffee_name = 'Latte' and index_1.cash_type = 'card'
group by index_1.coffee_name



- For each coffee type, get the average transaction amount.

select distinct (index_1.coffee_name), avg(index_1.money) as average_transaction_amount
from index_1
left join index_2 on index_1.date = index_2.date 
group by (index_1.coffee_name)



- List all transactions where the coffee name contains “Chocolate”.

select index_1.coffee_name, index_1.money as transactions
from index_1
left join index_2 on index_1.date = index_2.date 
where index_1.coffee_name LIKE '%Chocolate%'


