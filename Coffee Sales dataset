- Create a summary table: coffee type, count sold, total revenue.

select index_1.coffee_name, count (index_1.money) as number_of_coffee_sold, sum (index_1.money) as total_revenue
from index_1
left join index_2 on index_1.date = index_2.date
group by index_1.coffee_name;



