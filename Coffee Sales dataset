4. What’s the average transaction amount?

select avg(money) as average_transaction_amount
left join index_2 on index_1.date = index_2.date
from index_1;



5. Which coffee was sold the most times?

select coffee_name,  count (*) as coffee_sold
from index_1
left join index_2 on index_1.date = index_2.date
group by coffee_name
Order by count (*) desc
Having count (*) > 1;


6.  List all transactions where the amount is greater than 30.

select money 
from index_1
left join index_2 on index_1.date = index_2.date
where money > 30;



7.  Show all sales on a specific day (e.g., 2024-03-01).


select coffee_name, money
from index_1
left join index_2 on index_1.date = index_2.date
where date = '2024-03-01';


8.  Get the total money made from cash transactions.

select sum (money) as cash_transactions
from index_1
left join index_2 on index_1.date = index_2.date
where cash_type = 'cash';



9. List all transactions made using a card (from index_1).

select coffee_name, money as card_transactions
from index_1
where cash_type = 'card';


10. Find the earliest and latest transaction date.



11.  Group sales by coffee_name and show their total revenue.

select distinct coffee_name, sum (money) as total_revenue
left join index_2 on index_1.date = index_2.date
from index_1
group by distinct coffee_name; 


12.  How much was spent by each card (ignore nulls)?

select cash_type, money as money_spent_on_each_card
from index_1
left join index_2 on index_1.date = index_2.date
where cash_type = 'card' and card IS NOT NULL;



13.  Which day had the highest number of transactions?

select distinct date, count (coffee_name) as number_of_transactions
from index_1
left join index_2 on index_1.date = index_2.date
group by date
order by count (coffee_name) desc
Limit 5;



14.  Find the top 3 most expensive individual transactions.


select distinct (index_1.coffee_name), max (index_1.money) as expensive_transactions
from index_1
left join index_2 on index_1.date = index_2.date
group by (index_1.coffee_name)
order by expensive_transactions desc
limit 3


15.  How many different cardholders bought a “Latte”?

